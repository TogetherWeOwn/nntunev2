# Copy to wrangler.toml and fill in IDs. Never commit the real file:
# secrets live only in Cloudflare (Worker secrets / Hyperdrive) and CI secrets.
name = "nntune-api"
main = "build/worker/shim.mjs"
compatibility_date = "2026-10-01"

[build]
# `--locked` (after `--`, forwarded to `cargo build`) builds exactly the
# committed, audited workers/api/Cargo.lock and fails if it is stale.
command = "cargo install -q worker-build --locked && worker-build --release -- --locked"

[vars]
# Public, non-secret config only. RP_ORIGIN must be the canonical
# serialized https origin whose host is exactly RP_ID (the Worker
# refuses to start otherwise). http loopback needs ALLOW_LOOPBACK_DEV.
RP_ID = "example.com"
RP_ORIGIN = "https://example.com"
SESSION_TTL_SECS = "86400"
# Build identity for log lines (public, non-secret): the 40-char lowercase
# hex commit SHA supplied at deploy time by the `staging-api` lane in
# `.github/workflows/deploy.yml`
# (`deploy --env staging --var BUILD_SHA:${{ github.sha }}`). Until that
# lane runs configured (staging variables wired, deploy succeeded), every
# api line renders the explicit string "unknown".
# Workers log it as the `build_sha` field on every record; an absent or
# invalid value renders as "unknown" (never a missing key, never
# fail-closed), which means the lane did not supply it. Leave unset for
# local dev.
# BUILD_SHA = "unknown"
# INVITES_REQUIRED = "true"
# ALLOW_LOOPBACK_DEV = "true"          # local dev only, never staging/prod
# EMAIL_WEBHOOK_URL = "https://<mail-provider-webhook>"  # magic-link delivery
# Staging-only emailed-code retrieval seam (POST /api/test-codes, returns
# the issued code for example.test mailboxes without minting; see
# docs/security/threat-model.md). Staging env ONLY — never set on prod:
# QA_CODE_SEAM = "1" arms capture + retrieval, and QA_AUTH_TOKEN (secret,
# below) authenticates retrieval. Either missing answers the seam path
# with the plain unknown-route 404.
# QA_CODE_SEAM = "1"
# Rate-limit defaults live in src/rate_limit.rs (documented there: auth
# 10/60s, vault test-connection 5/60s per account and 25/60s per IP,
# single-sourced with src/vault.rs). The Worker entry reads these
# [vars] overrides at startup via RateLimitConfig::from_vars (invalid
# values fall back to the defaults; a max over 100 clamps to 100, the
# durable slot store's cap):
# AUTH_RATE_LIMIT_MAX / AUTH_RATE_LIMIT_WINDOW_SECS /
# VAULT_TEST_RATE_LIMIT_MAX / VAULT_TEST_RATE_LIMIT_WINDOW_SECS /
# VAULT_TEST_IP_RATE_LIMIT_MAX. Unset, the IP cap defaults to 5x the
# configured VAULT_TEST_RATE_LIMIT_MAX (clamped to 100).

# Hyperdrive binding for PlanetScale Postgres (ID filled per environment).
# The binding name must stay HYPERDRIVE (see src/worker_entry.rs).
# Auth reads (sessions, credentials, users, challenges, vaults) are plain
# SELECTs: Hyperdrive caches non-mutating queries by default (~60s + 15s
# stale-while-revalidate, never invalidated by writes), which would delay
# logout/revoke-all, break refresh rotation, and serve stale sign_counts.
# The HYPERDRIVE config MUST be created/updated with query caching disabled:
#   wrangler hyperdrive create <name> --connection-string "$DATABASE_URL" --caching-disabled
#   wrangler hyperdrive update <id> --caching-disabled
# Deploy gate: ./check_hyperdrive_cache.sh --config-id <id> (asserts
# caching.disabled == true). The gate fails closed without Cloudflare
# credentials (exit 3); --allow-skip is only for secret-less CI and MUST
# NOT be used in real deploys. Runtime attestation: the Worker refuses to
# serve traffic unless HYPERDRIVE_CACHING_DISABLED=1 is set for that env —
# set it only after the gate passes for that Hyperdrive config id.
# If cached reads are wanted elsewhere, bind a
# second cache-disabled config for auth reads.
# Runtime attestation (fail-closed): uncomment ONLY after
# ./check_hyperdrive_cache.sh passes for that env's Hyperdrive config id.
# Shipping it preset would attest a cache-disabled config without ever
# running the gate, defeating the startup refusal in src/worker_entry.rs.
# HYPERDRIVE_CACHING_DISABLED = "1"
# [[hyperdrive]]
# binding = "HYPERDRIVE"
# id = "<fill in staging/prod id>"

# Secrets (set with `wrangler secret put`, never here). All *BASE64 values
# are unpadded base64url (43 chars for 32 bytes; generate with
# `openssl rand 32 | basenc --base64url | tr -d '='`, decode with
# `nntune_api::b64::decode` — padded std base64 is rejected):
#   VAULT_KEK_BASE64              32-byte KEK, unpadded base64url (versioned; rotate via rewrap job)
#   VAULT_KEK_VERSION             integer version matching the KEK
#   SESSION_SECRET_BASE64         HMAC secret for session cookies (256-bit, unpadded base64url)
#   SESSION_SECRET_PREVIOUS_BASE64  verify-only previous HMAC secret: set ONLY
#                                 during a rotation window, deleted at its end.
#                                 Honored only when SESSION_SECRET_ROTATION=1
#                                 is also set (the recorded rotation); a staged
#                                 previous without it refuses to start (fail
#                                 closed), while the flag alone is single-secret
#                                 steady state (safe teardown order).
#                                 See docs/security/session-secret-rotation.md —
#                                 never two live minting secrets.
#   SESSION_SECRET_ROTATION         "1" only for the deploy(s) covering a
#                                 recorded rotation window; unset otherwise.
#   NATIVE_REST_PEPPER_BASE64       HMAC pepper for scoped native REST bearer
#                                 credentials (ADR 0010, migration 0019),
#                                 32+ bytes unpadded base64url. Dedicated
#                                 keyring, separate from SUBSONIC_INDEX_PEPPER
#                                 so either surface rotates without forcing
#                                 the other. BOTH pepper vars set, or neither:
#                                 unset, issuance endpoints fail closed
#                                 per-request and bearer routes 401 while
#                                 every other route keeps serving; half-set
#                                 refuses to start (fail closed).
#   NATIVE_REST_PEPPER_VERSION      integer version bound to the pepper above
#                                 (stored per row; lookup is by the exact
#                                 composite (pepper_version, key_hmac)).
#   EMAIL_API_KEY                 transactional email provider key (magic-link delivery)
#   QA_AUTH_TOKEN                 bearer for POST /api/test-codes (staging QA
#                                 seam only). High-entropy; same value as the
#                                 e2e-staging QA_AUTH_TOKEN secret. Staged only
#                                 together with QA_CODE_SEAM=1 (staging env);
#                                 never on prod.
