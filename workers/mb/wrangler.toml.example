# Example binding map for workers/mb. Copy to wrangler.toml locally;
# never commit real ids or secrets (see repo root .gitignore).
name = "nntune-mb"
main = "build/worker/shim.mjs"
compatibility_date = "2026-10-01"

# [[hyperdrive]]
# binding = "MB_DB"
# id = "<HYPERDRIVE_ID_FOR_nntunev2-mb>"
# localConnectionString = "<postgres://... (local dev only, never commit)>"

# [[kv_namespaces]]
# binding = "MB_CACHE"
# id = "<KV_NAMESPACE_ID>"

# Artwork cache: one R2 bucket per environment (docs/ops.md inventory).
# Binding activation stays with TOG-23680; uncomment when activating.
# Staging (`wrangler deploy --env staging`):
# [env.staging.vars]
# ENVIRONMENT = "staging"
# [[env.staging.r2_buckets]]
# binding = "ART_CACHE"
# bucket_name = "nntunev2-art-staging"
#
# Prod (`wrangler deploy --env production`):
# [env.production.vars]
# ENVIRONMENT = "production"
# [[env.production.r2_buckets]]
# binding = "ART_CACHE"
# bucket_name = "nntunev2-art-prod"
