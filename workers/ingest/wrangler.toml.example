# Binding map for workers/ingest. Copy to wrangler.toml locally; replace every
# `<...>` placeholder with the real id and never commit real ids or secrets
# (see repo root .gitignore).
name = "nntune-ingest"
main = "build/worker/shim.mjs"
compatibility_date = "2026-10-01"

# Slice 2: Queue + Workflow wiring (code: src/dispatch.rs, src/queue.rs).
[[queues.producers]]
binding = "INGEST_QUEUE"
queue = "nntune-ingest-jobs"

[[queues.consumers]]
queue = "nntune-ingest-jobs"
max_batch_size = 10
max_retries = 4

# The consumer replays src/queue.rs WORKFLOW_STEPS. workers-rs 0.3 has no
# Workflow client, so orchestration is Queue redelivery + job checkpoints
# (src/jobs.rs) until the Workflow binding is adopted.
[[workflows]]
binding = "INGEST_WORKFLOW"
name = "nntune-ingest-workflow"

# Slice 2: library writes (code: src/library.rs).
[[hyperdrive]]
binding = "LIBRARY_DB"
id = "<HYPERDRIVE_ID_FOR_nntunev2>"

# Checkpoint store for the Queue consumer (job_id -> JobCheckpoint JSON).
[[kv_namespaces]]
binding = "INGEST_STATE"
id = "<KV_NAMESPACE_ID>"

# Slice 2: usage metering (code: src/metering.rs).
[[analytics_engine_datasets]]
binding = "INGEST_METER"
dataset = "nntune_ingest_meter"

# Slice 2: repair dispatch target (code: src/repair.rs). The Container service
# name lands with the repair runtime; until then this stays a placeholder.
[[services]]
binding = "REPAIR_CONTAINER"
service = "<REPAIR_CONTAINER_SERVICE>"
