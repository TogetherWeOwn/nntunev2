# Binding map for workers/ingest. Copy to wrangler.toml locally; replace every
# `<...>` placeholder with the real id and never commit real ids or secrets
# (see repo root .gitignore).
name = "nntune-ingest"
main = "build/worker/shim.mjs"
compatibility_date = "2026-10-01"

[vars]
# Search rate-limit tunables (src/rate_limit.rs). Unset/invalid values
# keep the documented defaults: 10 searches per 60s (base plan quota).
# SEARCH_RATE_LIMIT_MAX = "10"
# SEARCH_RATE_LIMIT_WINDOW_SECS = "60"

# Slice 2: Queue producer (code: src/dispatch.rs, src/queue.rs). The routes
# produce; the consumer below stays disabled, so every accepted enqueue
# waits in the queue until it is enabled.
[[queues.producers]]
binding = "INGEST_QUEUE"
queue = "nntune-ingest-jobs"

# Slice T2: DLQ producer (code: src/retry.rs). The consumer sends one
# DlqEntry per quarantined message here — the original QueueMsg plus
# `error_code` and `attempts` fields in the serialized body — then acks the
# original so it is never redelivered. Producer-only: safe to declare before
# the consumer ships.
[[queues.producers]]
binding = "INGEST_DLQ"
queue = "nntune-ingest-dlq"

# Consumer: handler exists (`event(queue)` in src/queue_consumer.rs) but
# stays DISABLED. It validates each message, writes its checkpoint exactly
# once per delivery (Workers KV allows 1 write/s per key), digest-checks
# and parses upload payloads with the shared parser, probes their segments
# through the NNTP_POOL binding below (folded batches ride that one
# checkpoint write; the tally is keyed by batch index, so redelivery
# resumes without double-counting), runs the Verifying step (pool BODY
# fetches plus par2 judging over the INGEST_SCRATCH bucket below), and
# settles per message via src/retry.rs (`decide_checkpoint`): persist the
# mutated checkpoint before retry/ack, use `retry_with_options` while
# budget remains, and persist Failed before DLQ send + ack. Never ack on
# DLQ-send failure; Failed redelivery retries the send. A
# send-success/ack-failure may duplicate entries, so DLQ processing must
# be idempotent by job_id.
# Probing is capped per delivery (4 batches / 30 s in
# src/queue_consumer.rs, sized against max_batch_size = 10 below and the
# 15-minute consumer invocation limit): a budget stop persists the
# partial tally, enqueues a fresh copy of the message via the
# INGEST_QUEUE producer above (5 s delay), and acks the original, so a
# progressing job spends neither its attempt budget nor the max_retries
# slots below. If that enqueue fails the handler falls back to a native
# retry, which does spend a slot.
# The search/repair/match/write runtime steps are not wired yet, so
# enabling this now would burn every valid job's retry budget against an
# unavailable boundary and quarantine it. Uncomment only when those steps
# are executable. E.g.:
#
# [[queues.consumers]]
# queue = "nntune-ingest-jobs"
# max_batch_size = 10
# Keep max_retries = CONSUMER_MAX_RETRIES (4) in src/retry.rs: it equals
# PAYLOAD_RETRY_ATTEMPTS in src/dispatch.rs and MAX_ATTEMPTS - 1 in
# src/jobs.rs (a compile-time assert enforces this), and the retry backoff
# (5/15/30/60 s, 110 s cumulative) needs all four retries to cover the ~60 s
# KV lag plus the edge-cached negative-lookup window (consumer reads with
# cacheTtl 30).
# max_retries = 4
# On DLQ-send failure, the handler must call retry_with_options with a delay
# (or return an error) for that message; merely skipping ack() and returning
# implicitly acknowledges it. Each retry spends one of these four native
# max_retries slots, after which Cloudflare moves the raw body to the configured
# dead-letter queue; without dead_letter_queue, Cloudflare drops the message.
# It is a safety net for messages the handler never settles
# (panic, timeout): Cloudflare moves the untouched body with no reason envelope.
# Both shapes redrive via src/retry.rs (`redrive` for DlqEntry,
# `redrive_raw` for native bodies) after loading a matching Failed checkpoint;
# see README "Redrive" for raw bodies whose checkpoint is nonterminal.
# dead_letter_queue = "nntune-ingest-dlq"

# Workflows: NOT YET. This crate exports no Workflow class, and
# `[[workflows]]` requires a `class_name`, so
# any entry here is rejected at deploy. Orchestration until then is Queue
# redelivery + job checkpoints (src/jobs.rs). Re-add with `class_name` when
# the Workflow class ships.

# Slice 2: library writes (code: src/library.rs).
[[hyperdrive]]
binding = "LIBRARY_DB"
id = "<HYPERDRIVE_ID_FOR_nntunev2>"

# Checkpoint store for the Queue consumer (job_id -> JobCheckpoint JSON).
[[kv_namespaces]]
binding = "INGEST_STATE"
id = "<KV_NAMESPACE_ID>"

# Upload payload store (code: src/lib.rs store_upload_payload). The route
# writes the approved NZB bytes here under the content-addressed
# `nzb:sha256:<hex>` key from the Queue message before enqueueing; the
# consumer fetches them by that key. (Bytes cannot ride the Queue message:
# 2 MiB vs the 128 KB message limit.)
[[kv_namespaces]]
binding = "INGEST_PAYLOADS"
id = "<KV_NAMESPACE_ID_FOR_PAYLOADS>"

# Segment probe (code: src/pool_probe.rs). Cross-script binding to the stream
# Worker's per-user `NntpPool` Durable Object, addressed by
# `id_from_name(user_id)`; the object has no public route. Deploy the stream
# Worker (which declares the class) before this one.
[[durable_objects.bindings]]
name = "NNTP_POOL"
class_name = "NntpPool"
script_name = "nntune-stream"

# Verifying scratch staging (code: src/verify.rs, src/queue_consumer.rs).
# Fetched files are staged under `ingest-scratch/{job_id}/r{round}/in/…`
# plus a `manifest.json` as the repair handoff; the provisioned bucket's
# 7-day lifecycle rule on the `ingest-scratch/` prefix is the cleanup
# backstop (see docs/ops.md). Never bind the archive or audio-cache
# buckets here.
[[r2_buckets]]
binding = "INGEST_SCRATCH"
bucket_name = "<INGEST_SCRATCH_BUCKET>"

# Slice 2: usage metering (code: src/metering.rs).
[[analytics_engine_datasets]]
binding = "INGEST_METER"
dataset = "nntune_ingest_meter"

# Slice 2: repair dispatch target (code: src/repair.rs). The Container service
# name lands with the repair runtime; until then this stays a placeholder.
[[services]]
binding = "REPAIR_CONTAINER"
service = "<REPAIR_CONTAINER_SERVICE>"
