#!/usr/bin/python3
"""Fixture-only psql shim for exercising the caller's child I/O and cancellation."""

import os
import subprocess
import sys
import tempfile
from pathlib import Path

directory = Path(__file__).parent
mode, canary, address, expected_login, canonical_role, decoy_role = (directory / "route").read_text().split()
with (directory / "invocations").open("ab") as calls:
    calls.write(b"1")
if os.environ["PGUSER"] != expected_login:
    sys.exit(1)
# Model the provider's routing boundary before handing off to real libpq/TLS.
os.environ["PGUSER"] = decoy_role if mode == "wrong-role" else canonical_role
args = ["/usr/bin/psql", *sys.argv[1:]]
if mode in ("resolve", "baseline-interrupt", "baseline-wrong-oid"):
    # Route the test DNS name on the isolated network while libpq verifies PGHOST.
    os.environ["PGHOSTADDR"] = address
if mode in ("route", "resolve"):
    os.execv(args[0], args)

sql = sys.stdin.buffer.read()
if mode == "baseline-wrong-oid":
    result = subprocess.run(args, input=sql, stderr=subprocess.PIPE, timeout=5)
    # Write only a fixed marker for a server-side rejection at the OID guard.
    if result.returncode != 0 and b"ERROR:  baseline reader OID refused\n" in result.stderr:
        (directory / "baseline-result").write_text("reader-oid-refused\n")
    sys.exit(result.returncode)
if mode == "standby":
    result = subprocess.run(args, input=sql.replace(b"pg_is_in_recovery()", b"true"),
                            stderr=subprocess.PIPE, timeout=5)
    (directory / "standby-result").write_bytes(result.stderr)
    sys.exit(result.returncode)
if mode == "wrong-role":
    result = subprocess.run(args, input=sql, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=5)
    (directory / "probe-result").write_bytes(result.stdout)
    os.write(1, result.stdout)
    sys.exit(result.returncode)
if mode == "error":
    trace = ("+ PGPASSWORD=" + os.environ["PGPASSWORD"] + " PGHOST=" + os.environ["PGHOST"] + " psql\n").encode()
    result = subprocess.run(args, input=f"SELECT missing_{canary};\n".encode() + sql,
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=5)
    (directory / "diagnostics").write_bytes(trace + result.stderr)
    os.write(2, trace + result.stderr)
    sys.exit(result.returncode)

if mode == "interrupt":
    sql = sql.replace(b"ALTER DATABASE", b"SELECT pg_sleep(30);\nALTER DATABASE", 1)
elif mode == "baseline-interrupt":
    sql = sql.replace(b"SET LOCAL row_security = off;", b"SET LOCAL row_security = off;\nSELECT pg_sleep(30);", 1)
else:
    sys.exit(1)
with tempfile.TemporaryFile() as script:
    script.write(sql)
    script.seek(0)
    os.dup2(script.fileno(), 0)
    os.execv(args[0], args)
