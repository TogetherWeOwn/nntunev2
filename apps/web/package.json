{
	"name": "@nntune/web",
	"version": "0.1.0",
	"private": true,
	"description": "NNTune v2 web frontend (SvelteKit on Cloudflare). Billing slice: pricing, usage meters, checkout/portal.",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "prettier --check .",
		"format": "prettier --write ."
	},
	"dependencies": {
		"@sveltejs/kit": "2.70.3",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "7.2.9",
		"@sveltejs/vite-plugin-svelte": "5.1.1",
		"prettier": "^3.3.3",
		"prettier-plugin-svelte": "^3.2.6",
		"typescript": "^5.6.3",
		"vite": "6.4.4",
		"vitest": "4.1.11"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"workerd@1.20261012.1": true
	}
}
