      "request": { "bearer": "ok", "scopes": ["library:read", "stream:read"], "member": true, "grant": "ok", "grant_track_match": false, "grant_profile": null, "profile_param": null, "artifact": null, "range": null, "body_len": 1724, "provider_auth": "ok" },
      "expect": { "status": 403, "code": "forbidden", "retryable": false }
    },
    {
      "id": "botmx-017",
      "title": "revoked bearer is a generic 401 unauthorized",
      "request": { "bearer": "revoked", "scopes": ["library:read", "stream:read"], "member": true, "grant": "ok", "grant_track_match": true, "grant_profile": null, "profile_param": null, "artifact": null, "range": null, "body_len": 1724, "provider_auth": "ok" },
      "expect": { "status": 401, "code": "unauthorized", "retryable": false }
    },
    {
      "id": "botmx-018",
      "title": "non-member track is a 404 not_found, never 403",
      "request": { "bearer": "ok", "scopes": ["library:read", "stream:read"], "member": false, "grant": "ok", "grant_track_match": true, "grant_profile": null, "profile_param": null, "artifact": null, "range": null, "body_len": 1724, "provider_auth": "ok" },
      "expect": { "status": 404, "code": "not_found", "retryable": false }
    },
    {
      "id": "botmx-019",
      "title": "unsatisfiable range is a 416 range_not_satisfiable",
      "request": { "bearer": "ok", "scopes": ["library:read", "stream:read"], "member": true, "grant": "ok", "grant_track_match": true, "grant_profile": null, "profile_param": null, "artifact": null, "range": "bytes=99999-", "body_len": 1724, "provider_auth": "ok" },
      "expect": { "status": 416, "code": "range_not_satisfiable", "retryable": false }
    },
    {
