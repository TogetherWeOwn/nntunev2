      "request": { "bearer": "ok", "scopes": ["library:read", "stream:read"], "member": true, "grant": "ok", "grant_track_match": true, "grant_profile": null, "profile_param": null, "artifact": null, "range": null, "body_len": 1724, "provider_auth": "expired" },
      "expect": { "status": 401, "code": "provider_auth_expired", "retryable": false }
    },
